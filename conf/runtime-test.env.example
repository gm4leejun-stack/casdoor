# 复制为 conf/runtime-test.env 后编辑；真实文件已加入 .gitignore，不要提交。
# 用于 docker run --env-file 或容器平台的环境变量配置，不是前端 .env。
# Docker --env-file 不解析引号：值不要加外层引号，不要写行尾注释。

# 必改：容器可访问的 MySQL 地址、专用账号、密码；库名在 app-test.conf 配置。
# 项目会在末尾拼接 dbName，因此末尾保留 /，不要追加库名或 ?charset 等参数。
driverName=mysql
dataSourceName=casdoor_test:REPLACE_DB_PASSWORD@tcp(REPLACE_MYSQL_HOST:3306)/

# 建议 Redis 7.x（最低 6.2）；格式：HOST:PORT,POOL_SIZE,PASSWORD,DB。
# 无密码示例：redis.example.internal:6379,100,,0。
# 不用 Redis 的单实例测试请将这一行改成 redisEndpoint=。
# 密码不能含逗号；当前格式未提供 Redis ACL 用户名、Sentinel 或 TLS 参数。
redisEndpoint=REPLACE_REDIS_HOST:6379,100,REPLACE_REDIS_PASSWORD,0

# 以下仅在测试相应业务时取消注释并填写；不影响基础登录服务启动。
# 兑换码 Pepper 至少 16 字符；生成兑换码后必须保持稳定并备份。
# CASDOOR_MEMBERSHIP_CODE_PEPPER=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_16_CHARACTERS
# CASDOOR_MEMBERSHIP_SERVICE_TOKEN=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SERVICE_TOKEN

# 萨摩耶会员接口/联登使用；须申请测试商户及测试密钥，不能复用生产密钥。
# 公钥是萨摩耶 RSA 公钥，私钥是己方 RSA 私钥。
# 使用单行 Base64 DER，或包含字面量 \n 的单行 PEM；不要直接放多行 PEM。
# SMY_MEMBERSHIP_MERCHANT_NO=REPLACE_TEST_MERCHANT_NO
# SMY_MEMBERSHIP_PUBLIC_KEY=REPLACE_TEST_PUBLIC_KEY_BASE64_DER
# SMY_MEMBERSHIP_PRIVATE_KEY=REPLACE_TEST_PRIVATE_KEY_BASE64_DER
# SMY_UNION_LOGIN_BASE_URL=https://casdoor-test.example.com
# SMY_UNION_LOGIN_LOBEHUB_URL=https://lobehub-test.example.com/signin/smy
# SMY_UNION_LOGIN_APPLICATION=admin/lobehub

# 当前程序仍启动 RADIUS，请填写强密钥；普通 Web 测试不映射 UDP 1812。
radiusSecret=REPLACE_WITH_AN_INDEPENDENT_RANDOM_RADIUS_SECRET
